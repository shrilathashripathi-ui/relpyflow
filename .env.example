# ============================================================================
# ReplyFlow — environment configuration
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# Only the "REQUIRED" section is needed to boot. Everything under "OPTIONAL"
# enables an extra feature (payments, email, AI replies); leave any of them
# blank and the app still runs — that feature is simply disabled with a clear
# message in the logs.
# ============================================================================


# ─── REQUIRED: core server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Public URL of THIS backend (used in OAuth redirects & webhooks).
API_URL=http://localhost:5000
# URL of the frontend (used for CORS and post-login redirects).
FRONTEND_URL=http://localhost:5173


# ─── REQUIRED: database (PostgreSQL) ────────────────────────────────────────
# Either set DATABASE_URL (preferred — Prisma uses this)...
DATABASE_URL=postgresql://user:password@localhost:5432/replyflow
# ...or the individual fields below (used by the raw pg pool as a fallback).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=replyflow


# ─── REQUIRED: security ─────────────────────────────────────────────────────
# Secret used to sign JWT auth tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (any value the `jsonwebtoken` lib accepts, e.g. 24h, 7d).
JWT_EXPIRE=7d

# Key used to encrypt Instagram tokens/cookies at rest.
# Leave blank and the app auto-generates one on first run and saves it back
# here. In production, set this explicitly so it stays stable across deploys.
ENCRYPTION_KEY=


# ─── REQUIRED for Instagram automation: Meta / Instagram app ────────────────
# From your Meta app dashboard (https://developers.facebook.com).
# The code accepts several aliases for these; INSTAGRAM_CLIENT_* is canonical.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# The Instagram-specific app ID (used for the OAuth login button).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# OAuth redirect — must exactly match what's whitelisted in the Meta dashboard.
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:5000/api/instagram/callback/instagram

# Webhook verification token — any string; must match the value you enter
# in the Meta webhook config.
WEBHOOK_VERIFY_TOKEN=replyflow_webhook_verify_2025

# Optional legacy Graph API direct token (only if not using per-user OAuth).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=


# ============================================================================
# OPTIONAL — each block below enables one feature. Safe to leave blank.
# ============================================================================

# ─── OPTIONAL: email (OTP verification, password reset) ─────────────────────
# Without these, signup email verification / password reset are disabled.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── OPTIONAL: payments (Razorpay subscriptions) ────────────────────────────
# Without these, billing endpoints return "payments not configured".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# ─── OPTIONAL: AI-generated DM replies ──────────────────────────────────────
OPENAI_API_KEY=

# ─── OPTIONAL: admin / support ──────────────────────────────────────────────
# Where in-app support messages are routed.
ADMIN_EMAIL=

# ─── OPTIONAL: Redis (only if your deployment uses it) ──────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=


# ─── Feature flags / tuning ─────────────────────────────────────────────────
# Start background workers (comment poller, DM sender) with the server.
AUTO_START_WORKERS=true
# Master switch for actually sending DMs (set false to dry-run).
AUTOMATION_ENABLED=true
# Use the newer PostgreSQL job-queue pipeline instead of continuous polling.
USE_JOB_QUEUE=false
# Log verbosity: trace | debug | info | warn | error
LOG_LEVEL=info
