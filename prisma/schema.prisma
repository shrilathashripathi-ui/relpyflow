generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(uuid())
  email                     String    @unique
  name                      String?
  phone                     String?
  passwordHash              String?   @map("password_hash")
  emailVerified             Boolean   @default(false) @map("email_verified")
  verificationToken         String?   @map("verification_token")
  verificationTokenExpires  DateTime? @map("verification_token_expires")
  resetToken                String?   @map("reset_token")
  resetTokenExpires         DateTime? @map("reset_token_expires")

  subscriptionPlan          String    @default("free") @map("subscription_plan")
  subscriptionStatus        String    @default("trial") @map("subscription_status")
  trialEndsAt               DateTime? @map("trial_ends_at")
  subscriptionEndsAt        DateTime? @map("subscription_ends_at")

  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  instagramAccounts         InstagramAccount[]
  automations               Automation[]
  notificationSettings      NotificationSettings?
  subscriptions             Subscription[]
  usageTracking             UsageTracking[]

  @@map("users")
}

model InstagramAccount {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  igUserId            String?   @map("ig_user_id")
  username            String
  profilePictureUrl   String?   @map("profile_picture_url")

  // Official Instagram API (Graph API / Messaging API)
  accessToken         String?   @map("access_token")
  accessTokenExpiry   DateTime? @map("access_token_expiry")
  pageId              String?   @map("page_id") // Facebook Page ID linked to Instagram account
  useOfficialApi      Boolean   @default(false) @map("use_official_api")

  // Legacy session-based auth (fallback)
  sessionCookies      String?   @map("session_cookies")
  csrfToken           String?   @map("csrf_token")
  userAgent           String?   @map("user_agent")
  assignedProxyIp     String?   @map("assigned_proxy_ip")

  // Encrypted password for auto re-login (optional)
  encryptedPassword   String?   @map("encrypted_password")
  autoReloginEnabled  Boolean   @default(false) @map("auto_relogin_enabled")
  lastReloginAt       DateTime? @map("last_relogin_at")
  reloginFailCount    Int       @default(0) @map("relogin_fail_count")

  status              String    @default("active")
  lastActivityAt      DateTime? @map("last_activity_at")
  lastActionBlockAt   DateTime? @map("last_action_block_at")
  actionBlockCount    Int       @default(0) @map("action_block_count")

  // Circuit breaker
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  lastFailureAt       DateTime? @map("last_failure_at")
  isPaused            Boolean   @default(false) @map("is_paused")
  pauseReason         String?   @map("pause_reason")
  pausedUntil         DateTime? @map("paused_until")

  // Risk score engine (Phase 2)
  riskScore           Float     @default(0) @map("risk_score")
  riskUpdatedAt       DateTime? @map("risk_updated_at")

  // Account personality (Phase 7)
  behaviorSeed        Float?    @map("behavior_seed")          // 0.0-1.0 random seed (set once on creation)
  workingHoursStart   Int       @default(3)  @map("working_hours_start")  // Hour (0-23 UTC) when account "wakes up" — default 3 UTC = ~8:30 AM IST
  workingHoursEnd     Int       @default(17) @map("working_hours_end")    // Hour (0-23 UTC) when account "sleeps" — default 17 UTC = ~10:30 PM IST
  aggressionFactor    Float     @default(1.0) @map("aggression_factor")   // 0.5 = cautious, 1.0 = normal, 1.5 = aggressive

  // User override governance
  // If true, user has explicitly requested higher throughput despite system warnings.
  // Override caps throughput at 50% of base max (never full), adds 0.5 risk/hr,
  // and is auto-revoked after 24h or on first action block.
  overrideActive      Boolean   @default(false) @map("override_active")
  overrideRequestedAt DateTime? @map("override_requested_at")
  overrideExpiresAt   DateTime? @map("override_expires_at")
  overrideCount       Int       @default(0) @map("override_count")  // Lifetime count — escalating consequence

  accountAgeDays      Int       @default(0) @map("account_age_days")
  warmupMode          Boolean   @default(true) @map("warmup_mode")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  automations         Automation[]
  monitoredReels      MonitoredReel[]
  keywords            Keyword[]
  messageTemplates    MessageTemplate[]
  dmQueue             DmQueue[]
  dmHistory           DmHistory[]
  rateLimitConfig     RateLimitConfig?
  usernameFilters     UsernameFilter[]
  dailyAnalytics      DailyAnalytics[]

  @@unique([userId, username])
  @@map("instagram_accounts")
}

model MonitoredReel {
  id                      String    @id @default(uuid())
  igAccountId             String    @map("ig_account_id")
  mediaId                 String    @map("media_id")
  mediaUrl                String?   @map("media_url")
  thumbnailUrl            String?   @map("thumbnail_url")
  caption                 String?
  
  isActive                Boolean   @default(true) @map("is_active")
  lastCheckedAt           DateTime? @map("last_checked_at")
  
  customKeywords          String[]  @map("custom_keywords")
  customMessageTemplateId String?   @map("custom_message_template_id")
  
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  igAccount               InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  dmQueue                 DmQueue[]
  dmHistory               DmHistory[]

  @@unique([igAccountId, mediaId])
  @@map("monitored_reels")
}

model Keyword {
  id              String   @id @default(uuid())
  igAccountId     String   @map("ig_account_id")
  keyword         String
  isActive        Boolean  @default(true) @map("is_active")
  caseSensitive   Boolean  @default(false) @map("case_sensitive")
  createdAt       DateTime @default(now()) @map("created_at")

  igAccount       InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@map("keywords")
}

model MessageTemplate {
  id          String   @id @default(uuid())
  igAccountId String   @map("ig_account_id")
  name        String?
  content     String
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  igAccount   InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@map("message_templates")
}

model DmQueue {
  id                String    @id @default(uuid())
  igAccountId       String    @map("ig_account_id")
  monitoredReelId   String    @map("monitored_reel_id")
  
  recipientIgId     String    @map("recipient_ig_id")
  recipientUsername String    @map("recipient_username")
  
  commentId         String    @map("comment_id")
  commentText       String?   @map("comment_text")
  detectedKeyword   String?   @map("detected_keyword")
  
  messageToSend     String    @map("message_to_send")
  
  priority          Int       @default(0)
  scheduledAt       DateTime  @default(now()) @map("scheduled_at")
  
  status            String    @default("pending")
  
  retryCount        Int       @default(0) @map("retry_count")
  errorCode         String?   @map("error_code")
  errorMessage      String?   @map("error_message")

  // Causal chain: UUID generated at send time, links DM attempt → API response → enforcement event
  sendAttemptId     String?   @map("send_attempt_id")

  createdAt         DateTime  @default(now()) @map("created_at")
  processedAt       DateTime? @map("processed_at")
  sentAt            DateTime? @map("sent_at")

  igAccount         InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  monitoredReel     MonitoredReel @relation(fields: [monitoredReelId], references: [id], onDelete: Cascade)

  @@map("dm_queue")
}

model DmHistory {
  id                String    @id @default(uuid())
  igAccountId       String    @map("ig_account_id")
  monitoredReelId   String?   @map("monitored_reel_id")
  
  recipientIgId     String    @map("recipient_ig_id")
  recipientUsername String    @map("recipient_username")
  
  commentId         String?   @map("comment_id")
  commentText       String?   @map("comment_text")
  detectedKeyword   String?   @map("detected_keyword")
  
  messageSent       String?   @map("message_sent")

  status            String?
  errorMessage      String?   @map("error_message")

  // Send latency tracking (Phase: silent throttle detection)
  sendLatencyMs     Int?      @map("send_latency_ms")   // How long the send operation took

  // Reply tracking (Phase: ranking suppression detection)
  // If the recipient replied to our DM, record when. Null = no reply (yet).
  repliedAt         DateTime? @map("replied_at")

  // Causal chain: same UUID as DmQueue.sendAttemptId and EnforcementEvent.sendAttemptId
  // Links: DM attempt → API response → enforcement event → risk adjustment
  sendAttemptId     String?   @map("send_attempt_id")

  dmSentAt          DateTime  @default(now()) @map("dm_sent_at")

  igAccount         InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  monitoredReel     MonitoredReel? @relation(fields: [monitoredReelId], references: [id], onDelete: SetNull)

  @@unique([igAccountId, monitoredReelId, recipientIgId])
  @@index([igAccountId, dmSentAt])
  @@map("dm_history")
}

model RateLimitConfig {
  id                String   @id @default(uuid())
  igAccountId       String   @unique @map("ig_account_id")
  
  maxDmsPerHour     Int      @default(10) @map("max_dms_per_hour")
  maxDmsPerDay      Int      @default(50) @map("max_dms_per_day")
  minDelaySeconds   Int      @default(30) @map("min_delay_seconds")
  maxDelaySeconds   Int      @default(120) @map("max_delay_seconds")
  
  warmupEnabled     Boolean  @default(true) @map("warmup_enabled")
  
  updatedAt         DateTime @updatedAt @map("updated_at")

  igAccount         InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@map("rate_limit_config")
}

model NotificationSettings {
  id                    String   @id @default(uuid())
  userId                String   @unique @map("user_id")
  
  emailNotifications    Boolean  @default(true) @map("email_notifications")
  emailActionBlock      Boolean  @default(true) @map("email_action_block")
  emailSessionExpired   Boolean  @default(true) @map("email_session_expired")
  emailDailyLimit       Boolean  @default(true) @map("email_daily_limit")
  
  notificationEmail     String?  @map("notification_email")
  
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model DailyAnalytics {
  id                String   @id @default(uuid())
  igAccountId       String   @map("ig_account_id")
  date              DateTime @db.Date
  
  commentsDetected  Int      @default(0) @map("comments_detected")
  dmsQueued         Int      @default(0) @map("dms_queued")
  dmsSent           Int      @default(0) @map("dms_sent")
  dmsFailed         Int      @default(0) @map("dms_failed")
  actionBlocks      Int      @default(0) @map("action_blocks")

  igAccount         InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@unique([igAccountId, date])
  @@map("daily_analytics")
}

model UsernameFilter {
  id          String   @id @default(uuid())
  igAccountId String   @map("ig_account_id")
  username    String
  filterType  String   @map("filter_type")
  createdAt   DateTime @default(now()) @map("created_at")

  igAccount   InstagramAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@unique([igAccountId, username, filterType])
  @@map("username_filters")
}

model Subscription {
  id                           String    @id @default(uuid())
  userId                       String    @map("user_id")
  
  plan                         String
  status                       String
  
  paymentProvider              String?   @map("payment_provider")
  paymentProviderSubscriptionId String?  @map("payment_provider_subscription_id")
  
  currentPeriodStart           DateTime? @map("current_period_start")
  currentPeriodEnd             DateTime? @map("current_period_end")
  
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  user                         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UsageTracking {
  id                   String   @id @default(uuid())
  userId               String   @map("user_id")

  periodStart          DateTime @db.Date @map("period_start")
  periodEnd            DateTime @db.Date @map("period_end")

  dmsSentCount         Int      @default(0) @map("dms_sent_count")
  igAccountsConnected  Int      @default(0) @map("ig_accounts_connected")
  reelsMonitored       Int      @default(0) @map("reels_monitored")

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@map("usage_tracking")
}

// ============================================
// AUTOMATION MODELS (Comment & DM Automation)
// ============================================

model Automation {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  instagramAccountId  String    @map("instagram_account_id")

  name                String
  type                String    @default("comment") // "comment" or "dm"
  keywords            String[]  // Array of trigger keywords
  responseMessage     String    @map("response_message") // DM message to send
  commentReplyEnabled Boolean   @default(false) @map("comment_reply_enabled")
  commentReplyMessage String?   @map("comment_reply_message") // Public reply to comment
  commentReplies      String[]  @default([]) @map("comment_replies") // Array of random comment replies

  // DM Flow options
  openingButton       String?   @map("opening_button") // Reply keyword shown to user (e.g. "I want my free PDF")
  openingDmEnabled    Boolean   @default(true) @map("opening_dm_enabled")
  finalMessage        String?   @map("final_message") // Final message with link
  followUpEnabled     Boolean   @default(false) @map("follow_up_enabled")
  followUpMessage     String?   @map("follow_up_message")
  emailAskMessage     String?   @map("email_ask_message")

  // Selected posts/reels to monitor (if empty, monitors all)
  selectedMediaIds    String[]  @default([]) @map("selected_media_ids") // Array of media IDs to monitor
  monitorAllPosts     Boolean   @default(false) @map("monitor_all_posts") // If true, monitors all posts

  // Ask for Follow feature (Premium)
  askForFollowEnabled Boolean   @default(false) @map("ask_for_follow_enabled")
  askForFollowMessage String?   @map("ask_for_follow_message") // Message to send if not following
  skipNonFollowers    Boolean   @default(false) @map("skip_non_followers") // Skip DM entirely if not following

  // Lead Collection feature (Premium)
  leadCollectionEnabled Boolean @default(false) @map("lead_collection_enabled")
  leadFields          Json?     @map("lead_fields") // Array of { fieldName, fieldType, required }

  // AI Reply feature (Premium)
  aiReplyEnabled      Boolean   @default(false) @map("ai_reply_enabled")
  aiContext           String?   @map("ai_context") // Business context for AI
  aiProductInfo       String?   @map("ai_product_info") // Product/service info
  aiCtaUrl            String?   @map("ai_cta_url") // Call-to-action URL
  aiCtaLabel          String?   @map("ai_cta_label") // Button label for CTA

  // Webhook integration (n8n, Zapier, etc.)
  webhookEnabled      Boolean   @default(false) @map("webhook_enabled")
  webhookUrl          String?   @map("webhook_url") // URL to POST lead data
  webhookSecret       String?   @map("webhook_secret") // Secret for signature verification

  isActive            Boolean   @default(true) @map("is_active")

  // Stats
  triggerCount        Int       @default(0) @map("trigger_count")
  dmsSentCount        Int       @default(0) @map("dms_sent_count")
  leadsCollected      Int       @default(0) @map("leads_collected")
  dmsOpened           Int       @default(0) @map("dms_opened")
  linksClicked        Int       @default(0) @map("links_clicked")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramAccount    InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  triggers            Trigger[]
  leads               Lead[]

  @@map("automations")
}

model Trigger {
  id                  String    @id @default(uuid())
  automationId        String    @map("automation_id")

  // Who triggered
  commenterIgId       String    @map("commenter_ig_id")
  commenterUsername   String    @map("commenter_username")

  // What triggered
  commentId           String?   @map("comment_id")
  commentText         String?   @map("comment_text")
  matchedKeyword      String    @map("matched_keyword")

  // For DM automation (incoming DM trigger)
  incomingDmText      String?   @map("incoming_dm_text")

  // Actions taken
  dmSent              Boolean   @default(false) @map("dm_sent")
  dmSentAt            DateTime? @map("dm_sent_at")
  commentReplied      Boolean   @default(false) @map("comment_replied")
  commentRepliedAt    DateTime? @map("comment_replied_at")

  // Ask for Follow tracking
  isFollower          Boolean?  @map("is_follower")
  followRequested     Boolean   @default(false) @map("follow_requested")
  followedAt          DateTime? @map("followed_at")

  // Status
  status              String    @default("pending") // pending, dm_sent, failed, permanent_failed, waiting_follow
  errorMessage        String?   @map("error_message")

  // DM retry tracking (across requeue cycles, not just within a single DM job)
  dmRetryCount        Int       @default(0) @map("dm_retry_count")
  lastDmAttemptAt     DateTime? @map("last_dm_attempt_at")
  lastDmFailureReason String?   @map("last_dm_failure_reason")

  // Conversation flow tracking
  conversationStep    String    @default("opening") @map("conversation_step") // opening, waiting_button, waiting_follow, waiting_email, link_sent, completed
  buttonClicked       Boolean   @default(false) @map("button_clicked")
  buttonClickedAt     DateTime? @map("button_clicked_at")
  emailCollected      String?   @map("email_collected")
  linkSent            Boolean   @default(false) @map("link_sent")
  linkSentAt          DateTime? @map("link_sent_at")
  followUpSent        Boolean   @default(false) @map("follow_up_sent")
  followUpSentAt      DateTime? @map("follow_up_sent_at")

  createdAt           DateTime  @default(now()) @map("created_at")

  automation          Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, commentId]) // Prevent duplicate triggers for same comment
  @@map("triggers")
}

// ============================================
// LEAD COLLECTION
// ============================================

model Lead {
  id                  String    @id @default(uuid())
  automationId        String    @map("automation_id")

  // Instagram user info
  igUserId            String    @map("ig_user_id")
  igUsername          String    @map("ig_username")

  // Collected data
  email               String?
  phone               String?
  name                String?
  customData          Json?     @map("custom_data") // Any additional fields

  // Source info
  sourceCommentId     String?   @map("source_comment_id")
  sourceMediaId       String?   @map("source_media_id")

  // Status
  isComplete          Boolean   @default(false) @map("is_complete")
  currentStep         Int       @default(0) @map("current_step") // Which field we're collecting

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  automation          Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, igUserId])
  @@map("leads")
}

// ============================================
// CONVERSATION FLOW SYSTEM
// ============================================

model ConversationFlow {
  id                  String    @id @default(uuid())
  automationId        String    @map("automation_id")

  name                String
  description         String?

  // Flow configuration stored as JSON
  // Contains nodes (steps) and edges (connections)
  flowConfig          Json      @map("flow_config")

  isActive            Boolean   @default(true) @map("is_active")

  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  steps               ConversationStep[]
  conversations       Conversation[]

  @@map("conversation_flows")
}

model ConversationStep {
  id                  String    @id @default(uuid())
  flowId              String    @map("flow_id")

  stepOrder           Int       @map("step_order")
  stepType            String    @map("step_type") // "message", "condition", "delay", "reminder", "ask_follow"

  // For message steps
  messageText         String?   @map("message_text")
  attachmentUrl       String?   @map("attachment_url") // Link or image URL
  attachmentType      String?   @map("attachment_type") // "link", "image"
  buttonText          String?   @map("button_text")
  buttonUrl           String?   @map("button_url")

  // For condition steps (if user replies with keyword)
  conditionType       String?   @map("condition_type") // "keyword", "is_follower", "any_reply"
  conditionKeywords   String[]  @default([]) @map("condition_keywords")
  conditionOperator   String?   @map("condition_operator") // "contains", "equals", "starts_with"

  // For delay/reminder steps
  delayMinutes        Int?      @map("delay_minutes")
  reminderEnabled     Boolean   @default(false) @map("reminder_enabled")

  // Navigation
  nextStepOnSuccess   String?   @map("next_step_on_success") // Step ID to go to if condition met
  nextStepOnFailure   String?   @map("next_step_on_failure") // Step ID if condition not met

  createdAt           DateTime  @default(now()) @map("created_at")

  flow                ConversationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@map("conversation_steps")
}

model Conversation {
  id                  String    @id @default(uuid())
  flowId              String    @map("flow_id")
  igAccountId         String    @map("ig_account_id")

  // User in conversation
  userIgId            String    @map("user_ig_id")
  userUsername        String    @map("user_username")

  // Current state
  currentStepId       String?   @map("current_step_id")
  status              String    @default("active") // "active", "completed", "paused", "waiting_reply"

  // Tracking
  isFollower          Boolean?  @map("is_follower")
  lastMessageSentAt   DateTime? @map("last_message_sent_at")
  lastReplyReceivedAt DateTime? @map("last_reply_received_at")
  lastReplyText       String?   @map("last_reply_text")

  // Reminder tracking
  nextReminderAt      DateTime? @map("next_reminder_at")
  reminderCount       Int       @default(0) @map("reminder_count")

  startedAt           DateTime  @default(now()) @map("started_at")
  completedAt         DateTime? @map("completed_at")

  flow                ConversationFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  messages            ConversationMessage[]

  @@unique([flowId, userIgId])
  @@map("conversations")
}

model ConversationMessage {
  id                  String    @id @default(uuid())
  conversationId      String    @map("conversation_id")
  stepId              String?   @map("step_id")

  direction           String    // "outgoing" or "incoming"
  messageText         String    @map("message_text")
  attachmentUrl       String?   @map("attachment_url")

  // Status
  status              String    @default("pending") // "pending", "sent", "delivered", "failed"
  errorMessage        String?   @map("error_message")

  sentAt              DateTime? @map("sent_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

// ============================================
// SCHEDULED REMINDERS
// ============================================

model ScheduledReminder {
  id                  String    @id @default(uuid())
  automationId        String    @map("automation_id")
  igAccountId         String    @map("ig_account_id")

  // Target user
  recipientIgId       String    @map("recipient_ig_id")
  recipientUsername   String    @map("recipient_username")

  // Reminder content
  messageText         String    @map("message_text")
  attachmentUrl       String?   @map("attachment_url")
  attachmentType      String?   @map("attachment_type")

  // Scheduling
  scheduledAt         DateTime  @map("scheduled_at")
  reminderType        String    @map("reminder_type") // "one_time", "recurring"
  recurringInterval   Int?      @map("recurring_interval") // Hours between reminders
  maxReminders        Int       @default(3) @map("max_reminders")
  remindersSent       Int       @default(0) @map("reminders_sent")

  // Status
  status              String    @default("scheduled") // "scheduled", "sent", "cancelled", "completed"

  createdAt           DateTime  @default(now()) @map("created_at")
  sentAt              DateTime? @map("sent_at")

  @@map("scheduled_reminders")
}

// ============================================
// ACCOUNT HEALTH SNAPSHOTS (daily metrics for trend detection)
// ============================================

model AccountHealthSnapshot {
  id                String    @id @default(uuid())
  igAccountId       String    @map("ig_account_id")

  date              DateTime  @db.Date // One snapshot per account per day

  // Volume
  dmsSent           Int       @default(0) @map("dms_sent")
  dmsFailed         Int       @default(0) @map("dms_failed")
  dmsDropped        Int       @default(0) @map("dms_dropped")
  dmsExpired        Int       @default(0) @map("dms_expired")

  // Quality
  successRate       Float?    @map("success_rate")      // sent / (sent + failed), null if no data
  avgLatencyMs      Int?      @map("avg_latency_ms")    // Average send latency for the day
  replyRate         Float?    @map("reply_rate")         // replies received / DMs sent, null if no data

  // Risk
  riskScoreEnd      Float     @default(0) @map("risk_score_end")  // Risk score at end of day

  // Volatility (standard deviation — high = unstable metrics)
  successRateStddev Float?    @map("success_rate_stddev")  // Rolling 7-day stddev of daily success rates
  latencyStddev     Float?    @map("latency_stddev")       // Rolling 7-day stddev of daily avg latency
  volumeStddev      Float?    @map("volume_stddev")        // Rolling 7-day stddev of daily send volume

  createdAt         DateTime  @default(now()) @map("created_at")

  @@unique([igAccountId, date])
  @@index([igAccountId, date])
  @@map("account_health_snapshots")
}

// ============================================
// ENFORCEMENT EVENT LOG (ground truth for calibration)
// ============================================
// Every enforcement signal, state transition, and system decision is logged here.
// This is the ONLY table that allows statistical validation of kill logic,
// throttle tuning, and health score calibration.
//
// Without this table, everything else is hypothesis.

model EnforcementEvent {
  id                String    @id @default(uuid())
  igAccountId       String    @map("ig_account_id")

  // Event classification
  eventType         String    @map("event_type")
  // Values: action_blocked, rate_limited, session_expired, dm_restricted,
  //         kill_triggered, throttle_activated, throttle_released,
  //         override_requested, override_expired, override_revoked,
  //         unpause, latency_anomaly, success_rate_drop, recovery_detected

  // What triggered this event
  triggerSource     String    @map("trigger_source")
  // Values: instagram_api, puppeteer_dom, circuit_breaker, risk_engine,
  //         kill_threshold, adaptive_baseline, latency_detector, user_action

  // Error context (captured at detection time)
  errorMessage      String?   @map("error_message")       // Raw error message (up to 1000 chars)
  httpStatusCode    Int?      @map("http_status_code")     // 429, 400, 401, 403, etc.
  errorSubcode      String?   @map("error_subcode")        // Meta API error subcode if available

  // Account state snapshot at event time (for calibration)
  riskScoreAtEvent  Float     @map("risk_score_at_event")  // Risk score when event occurred
  successRateAtEvent Float?   @map("success_rate_at_event") // 24h success rate
  latencyAtEvent    Int?      @map("latency_at_event")     // Avg latency (ms) at event time
  density60AtEvent  Int?      @map("density60_at_event")   // DMs sent in last 60min
  dailySentAtEvent  Int?      @map("daily_sent_at_event")  // DMs sent today

  // Contextual flags (Advisory #6: without these, post-mortem analysis is noisy)
  overrideActiveAtEvent  Boolean  @default(false) @map("override_active_at_event")  // Was user override active?
  accountPausedAtEvent   Boolean  @default(false) @map("account_paused_at_event")   // Was account already paused?
  volatilityLevelAtEvent String?  @map("volatility_level_at_event")                  // stable/moderate/high at event time

  // Decision model version — enables comparing calibration across logic changes.
  // If you change thresholds, bump this. Without versioning, future calibration is muddy.
  controlModelVersion    String   @default("1.0.0") @map("control_model_version")

  // Causal chain: links enforcement event to the specific send attempt that caused it.
  // sendAttemptId is generated at DM send time and flows through:
  //   DM attempt → API response → enforcement event → risk adjustment
  // This turns timestamp correlation into provable causation.
  sendAttemptId     String?   @map("send_attempt_id")

  // Decision context
  actionTaken       String    @map("action_taken")
  // Values: paused_24h, paused_2h, paused_30m, throttled_50pct, throttled_25pct,
  //         risk_added, override_granted, override_revoked, no_action

  riskDelta         Float?    @map("risk_delta")           // How much risk was added/removed
  throughputBefore  Int?      @map("throughput_before")    // maxHour before this event
  throughputAfter   Int?      @map("throughput_after")     // maxHour after this event

  // Recovery tracking (filled in later when account recovers)
  // Deterministic recovery criteria (all must be true simultaneously):
  //   1. Account is not paused (isPaused = false)
  //   2. Success rate > 80% over 2h window (minimum 5 samples)
  //   3. Latency within 1.5× of 7-day baseline
  //   4. No enforcement events for 2h
  resolvedAt        DateTime? @map("resolved_at")          // When account recovered from this event
  recoveryDurationMs Int?     @map("recovery_duration_ms") // How long recovery took

  // DM context (which specific DM triggered the event, if applicable)
  dmQueueId         String?   @map("dm_queue_id")
  recipientUsername String?   @map("recipient_username")

  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([igAccountId, createdAt])
  @@index([eventType, createdAt])
  @@index([sendAttemptId])
  @@map("enforcement_events")
}